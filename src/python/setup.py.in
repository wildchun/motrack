"""setup.py for the pybytetrack wheel.

This file is generated by CMake (see CMakeLists.txt, WITH_PYTHON=ON) into the
build tree at ${CMAKE_BINARY_DIR}/wheel/setup.py — do not edit the copy under
build/. Edit src/python/setup.py.in instead.

The wheel is a thin binary distribution around the pybind11 extension:

    pybytetrack/
        __init__.py                       # re-exports the .so
        pybytetrack.cpython-XY-*.so       # the pybind11 module

so that after ``pip install`` users can still do ``import pybytetrack`` and
reach ``ByteTracker`` / ``Rect`` / ``Object`` / ``Track`` unchanged.
"""
from setuptools import setup, Distribution

# Force a platform-tagged wheel (e.g. cp310-cp310-linux_x86_64) rather than the
# default ``py3-none-any`` — we're shipping a compiled extension.
try:
    from wheel.bdist_wheel import bdist_wheel as _bdist_wheel

    class bdist_wheel(_bdist_wheel):
        def finalize_options(self):
            super().finalize_options()
            self.root_is_pure = False
except ImportError:  # pragma: no cover — wheel is a build-time dep only
    bdist_wheel = None


class BinaryDistribution(Distribution):
    """Tells setuptools this project ships a compiled extension."""

    def has_ext_modules(self):
        return True


setup(
    name="pybytetrack",
    version="@BYTETRACK_WHEEL_VERSION@",
    description="Python bindings for ByteTrackLib — a C++11 reimplementation of ByteTrack.",
    author="ByteTrackLib contributors",
    license="MIT",
    url="https://github.com/ifzhang/ByteTrack",
    packages=["pybytetrack"],
    package_data={"pybytetrack": ["*.so", "*.pyd"]},
    include_package_data=True,
    distclass=BinaryDistribution,
    cmdclass={"bdist_wheel": bdist_wheel} if bdist_wheel else {},
    python_requires=">=3.6",
    classifiers=[
        "Programming Language :: Python :: 3",
        "Programming Language :: C++",
        "Operating System :: POSIX :: Linux",
        "Topic :: Scientific/Engineering :: Image Recognition",
    ],
)
